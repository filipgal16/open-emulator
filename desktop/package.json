{
  "name": "open-emulator-desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Windows desktop shell for open-emulator, driving a WSL2-hosted Android backend.",
  "author": "open-emulator contributors",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json",
    "build:renderer": "node scripts/build-renderer.mjs",
    "build": "npm run build:main && npm run typecheck:renderer && npm run build:renderer && node scripts/copy-static.mjs",
    "test": "npm run build:main && node --test \"test/**/*.test.mjs\"",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "icon": "node scripts/make-icon.mjs",
    "dist:win": "npm run build && npm run icon && electron-builder --win --publish never",
    "dist:dir": "npm run build && npm run icon && electron-builder --win --dir --publish never",
    "rom:build": "npm run build:main && node scripts/rom-build.mjs",
    "rom:check": "npm run build:main && node scripts/rom-check.mjs",
    "wallpaper": "npm run build:main && node scripts/render-wallpaper.mjs"
  },
  "build": {
    "appId": "com.openemulator.desktop",
    "productName": "open-emulator",
    "copyright": "open-emulator contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../android",
        "to": "backend/android",
        "filter": [
          "**/*",
          "!sdk/**",
          "!avd/**",
          "!state/**",
          "!logs/**",
          "!apps/*.apk",
          "!**/*.img",
          "!**/*.qcow2"
        ]
      },
      {
        "from": "../scripts",
        "to": "backend/scripts"
      },
      {
        "from": "../Makefile",
        "to": "backend/Makefile"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "open-emulator",
      "deleteAppDataOnUninstall": false,
      "allowElevation": false
    },
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ]
  },
  "dependencies": {
    "koffi": "^3.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.23.1": true,
    "koffi@3.1.6": true
  }
}
