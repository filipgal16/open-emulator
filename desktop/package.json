{
  "name": "open-emulator",
  "version": "0.4.0",
  "private": true,
  "description": "Mint-branded emulator shell with wizard, tabs, and isolated VMs.",
  "main": "main.js",
  "desktopName": "open-emulator",
  "homepage": "https://github.com/filipgal16/open-emulator",
  "author": {
    "name": "open-emulator contributors",
    "email": "filipgal16@users.noreply.github.com"
  },
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage deb",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:dir": "electron-builder --dir --linux AppImage"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3"
  }
}
