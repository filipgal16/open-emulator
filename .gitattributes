# Pinned to LF so these read the same on every checkout, whatever `core.autocrlf` says: the profile
# and device `.env` files are parsed by the app byte for byte.
*.sh           text eol=lf
*.env          text eol=lf

# Byte-exact ROM test fixtures: a disk image, and build.prop files lifted from the stock system
# image. A line-ending conversion would make the tests compare against something Android never
# shipped.
*.img.gz                                binary
crates/oe-formats/testdata/build.prop.* -text
