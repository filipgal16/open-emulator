# Imported / generated Android artifacts (do not commit)
android/sdk/
android/avd/
android/logs/
android/state/
# Guest images for the FOSS runtime — ~1 GB each, fetched with `open-emu-foss fetch`.
android/images/
*.iso
android/apps/*.apk
android/**/*.img
android/**/*.qcow2
!android/apps/.gitkeep

build/
*.o
*.bin
.open-vmm*
.DS_Store

# Electron desktop shell
desktop/node_modules/
desktop/dist/
desktop/out/
# Installer output, and the generated app icon (rebuild with `npm run icon`).
desktop/release/
desktop/build/

# Scoped briefs handed to the Cursor CLI. Working files, not part of the product.
.cursor-brief.md
