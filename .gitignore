# Imported / generated Android artifacts (do not commit)
android/sdk/
android/avd/
android/logs/
android/state/
android/apps/*.apk
android/**/*.img
android/**/*.qcow2
!android/apps/.gitkeep

/build/
*.o
*.bin
.open-vmm*
.DS_Store

# Desktop shell runtime
desktop/node_modules/
desktop/data/
desktop/uploads/
# desktop/build/ holds the committed source icon for electron-builder — only
# its packaged output is generated/ignored.
desktop/dist-electron/

# Generated marketing site
web/dist/

# Monetization server/licensing runtime state — private keys and event
# logs must never be committed. desktop/config/license-public-key.json is
# a *public* key and is intentionally NOT covered by this.
monetize/server/data/
monetize/licensing/keys/

