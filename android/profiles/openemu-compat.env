# "openemu-compat" profile — open-emulator Android (Google APIs): our ROM for ARM games.
#
# Built on the user's machine like `openemu`, but from Google's **Google APIs** image rather than
# the AOSP one, because that is the image that carries an ARM translator: without one, an app that
# ships only ARM libraries — nearly every game — does not install. The build removes the Google
# and AOSP apps an emulator has no use for, leaves Play services and Google's device identity as
# shipped (sign-in depends on both), and rewrites the translator's cpuinfo so ARM apps see every
# guest core instead of one. What it does and why is in design/openemu-rom.md ("openemu-compat")
# and desktop/src/main/rom/recipe-compat.ts; `npm run rom:build -- --recipe openemu-compat` in
# desktop/ runs it by hand.
#
# Unlike `openemu` this image contains Google Mobile Services and is derived from a Google binary.
# It is never redistributed: each machine downloads the base under Google's SDK licence and builds
# its own. See LICENSING.md before shipping it as a default.
#
# Native runtime only, like `openemu`.

PROFILE_NAME=openemu-compat
PROFILE_DESC="open-emulator Android (Google APIs) — runs ARM games, with Google Play services"

PROFILE_SYSTEM_IMAGE="system-images;android-34;openemu-compat;x86_64"
PROFILE_IMAGE_TAG=openemu-compat
PROFILE_API_LEVEL=34

# Derived: setup downloads this image, then builds ours from it.
PROFILE_BASE_IMAGE_TAG=google_apis

# Google APIs has Play services but no Play Store app; apps arrive as APK files.
PROFILE_PLAYSTORE=false

# Android 14 with Play services leaves about 2.7 GB of 4 GB available at idle, and an ARM game
# under translation needs more than the 3 GB default would leave it.
PROFILE_RAM_MB=4096

# Its own AVD, so switching profiles never loads another profile's snapshot against the wrong image.
PROFILE_AVD_NAME=OpenEmulator_API34_compat
