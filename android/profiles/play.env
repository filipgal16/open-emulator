# "play" profile — Google's Play-enabled system image, for the Store tab's Play source.
#
# This is the only profile that ships the Play Store app itself. `google_apis` (the "full" profile)
# carries GMS but not com.android.vending, so Play cannot be opened there; google_apis_playstore is
# Google's own SDK image with both, which is why the store wraps it rather than side-loading Play.
#
# Two costs worth knowing before choosing it:
#
#   1. `adb root` is refused on Play images — they are user builds. customize_device.sh cannot run
#      against this profile.
#   2. Play certification is tied to the image's own fingerprint. Rewriting build.prop to
#      impersonate a retail device (build_custom_image.sh) will produce "device is not Play Protect
#      certified" and block sign-in, so keep this profile on the stock `generic` device identity.
#      The Store's Play tab detects a spoofed fingerprint and says so.

PROFILE_NAME=play
PROFILE_DESC="Google Play Store — sign in and install real apps"

PROFILE_SYSTEM_IMAGE="system-images;android-30;google_apis_playstore;x86_64"
PROFILE_IMAGE_TAG=google_apis_playstore

# True here and nowhere else: this image really does ship the Play Store, so config.ini may say so.
PROFILE_PLAYSTORE=true

# Its own AVD, so switching profiles never loads another profile's snapshot against the wrong image.
PROFILE_AVD_NAME=OpenEmulator_API30_play
