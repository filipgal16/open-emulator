# "openemu" profile — open-emulator Android: our own ROM, derived from the open-source image.
#
# Not downloaded from Google as-is: the app downloads the `default` (AOSP, Apache-2.0 userspace)
# image and builds this one from it on the user's machine — debloated, rebranded, carrying its own
# files, and re-signed so /system boots without dm-verity restoring Google's bytes. What the build
# does and why is in design/openemu-rom.md; `npm run rom:build` in desktop/ runs it by hand. No
# Google Mobile Services, so nothing in it carries a redistribution condition.
#
# Native runtime only: the ROM toolchain is TypeScript in the desktop app, and the WSL runtime
# keeps the stock profiles.

PROFILE_NAME=openemu
PROFILE_DESC="open-emulator Android — our own tuned build, no Google Play"

PROFILE_SYSTEM_IMAGE="system-images;android-30;openemu;x86_64"
PROFILE_IMAGE_TAG=openemu

# Derived: setup downloads this image, then builds ours from it.
PROFILE_BASE_IMAGE_TAG=default

PROFILE_PLAYSTORE=false

# Its own AVD, so switching profiles never loads another profile's snapshot against the wrong image.
PROFILE_AVD_NAME=OpenEmulator_API30_openemu
