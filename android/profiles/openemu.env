# "openemu" profile — our own build of Android, derived from the open-source image.
#
# Not downloaded from Google: built locally from the `default` (AOSP, Apache-2.0) image by
# `npm run build:image` in desktop/, or by the setup wizard when this profile is selected. What the
# build does — debloat, rebrand, mark — is in design/custom-image.md. No Google Mobile Services, so
# nothing in it carries a redistribution condition.
#
# The WSL runtime does not know how to build this image; it is a native-runtime profile.

PROFILE_NAME=openemu
PROFILE_DESC="open-emulator Android — our own tuned build, no Google Play"

PROFILE_SYSTEM_IMAGE="system-images;android-30;openemu;x86_64"
PROFILE_IMAGE_TAG=openemu

# Derived: setup downloads this image, then builds ours from it.
PROFILE_BASE_IMAGE_TAG=default

PROFILE_PLAYSTORE=false

# Its own AVD, so switching profiles never loads another profile's snapshot against the wrong image.
PROFILE_AVD_NAME=OpenEmulator_API30_openemu
