# "full" profile — Google APIs guest, for apps that need GMS.
#
# LICENSING: this image bundles Google Mobile Services, which is proprietary and cannot be
# redistributed. Fine for personal use; shipping it commercially needs an agreement with Google.
# The "fast" profile is plain AOSP (Apache-2.0) and carries no such condition. See LICENSING.md.
#
# Boots slower than "fast" because Play Services starts a large set of services. Use it when an app
# actually depends on GMS (Play billing, Play Games, Maps SDK, push).

PROFILE_NAME=full
PROFILE_DESC="Google APIs + Play Services — best app compatibility"

PROFILE_SYSTEM_IMAGE="system-images;android-30;google_apis;x86_64"
PROFILE_IMAGE_TAG=google_apis

# The google_apis image ships GMS but not the Play Store app itself; google_apis_playstore does.
# Kept false so the AVD config does not claim a Play Store that is not present.
PROFILE_PLAYSTORE=false

PROFILE_AVD_NAME=OpenEmulator_API30
