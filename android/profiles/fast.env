# "fast" profile — lean AOSP guest, no Google Play Services. This is the default.
#
# GMS starts a large set of services during boot, and most apps run fine without it. Dropping it is
# the single biggest cold-boot saving available, at the cost of Play Store and GMS-dependent apps
# (use the "full" profile for those).

PROFILE_NAME=fast
PROFILE_DESC="AOSP, no Google Play Services — fastest boot"

# Plain AOSP tag (`default`), as opposed to `google_apis`, which bundles GMS.
PROFILE_SYSTEM_IMAGE="system-images;android-30;default;x86_64"
PROFILE_IMAGE_TAG=default

# No Play Store in this image, so do not advertise one. The old config claimed
# PlayStore.enabled=true on an image that never shipped Play — this makes the two agree.
PROFILE_PLAYSTORE=false

# A distinct AVD name so switching profiles does not silently reuse the other profile's snapshot,
# which would fail to load and force a re-provision.
PROFILE_AVD_NAME=OpenEmulator_API30_fast
