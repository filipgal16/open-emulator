# Google Pixel 5 — Android 11 (RQ3A.211001.001)
#
# Stock AVD images identify as brand "Android", model "mainline", device "generic". Plenty of apps
# treat that as an emulator and refuse to run, so presenting a real device is a compatibility
# feature, not cosmetics. LDPlayer and BlueStacks both ship exactly this kind of device picker.

DEVICE_NAME="Pixel 5"
DEVICE_BRAND=google
DEVICE_MANUFACTURER=Google
DEVICE_MODEL="Pixel 5"
DEVICE_PRODUCT=redfin
DEVICE_DEVICE=redfin
DEVICE_FINGERPRINT="google/redfin/redfin:11/RQ3A.211001.001/7641976:user/release-keys"
DEVICE_BUILD_ID=RQ3A.211001.001
DEVICE_BUILD_TAGS=release-keys
DEVICE_BUILD_TYPE=user

# Panel geometry. Kept modest on purpose: the mirror path scales whatever the guest renders, and a
# larger panel costs boot time and per-frame cost for no benefit in a headless setup.
DEVICE_LCD_WIDTH=1080
DEVICE_LCD_HEIGHT=2340
DEVICE_LCD_DENSITY=440
