# No device spoofing — the guest reports whatever the stock system image says.
#
# The honest default. Use this when debugging the emulator itself, or when you want app behaviour
# to reflect a stock AOSP build rather than a particular handset. Empty values mean open-emu
# passes no -prop overrides at all.

DEVICE_NAME="Generic (stock image identity)"
DEVICE_BRAND=
DEVICE_MANUFACTURER=
DEVICE_MODEL=
DEVICE_PRODUCT=
DEVICE_DEVICE=
DEVICE_FINGERPRINT=
DEVICE_BUILD_ID=
DEVICE_BUILD_TAGS=
DEVICE_BUILD_TYPE=

# Match the AVD template's panel so nothing is rewritten.
DEVICE_LCD_WIDTH=720
DEVICE_LCD_HEIGHT=1280
DEVICE_LCD_DENSITY=240
