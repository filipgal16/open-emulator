# Xiaomi Redmi Note 11 — a very common budget Android device.
#
# Worth having alongside the Pixel: mobile games frequently gate features or graphics tiers on
# manufacturer, and Xiaomi is one of the most widely deployed profiles in the wild. LDPlayer ships
# a Xiaomi profile by default for the same reason.

DEVICE_NAME="Redmi Note 11"
DEVICE_BRAND=Redmi
DEVICE_MANUFACTURER=Xiaomi
DEVICE_MODEL="2201117TG"
DEVICE_PRODUCT=spes_global
DEVICE_DEVICE=spes
DEVICE_FINGERPRINT="Redmi/spes_global/spes:11/RP1A.200720.011/V13.0.6.0.RGCMIXM:user/release-keys"
DEVICE_BUILD_ID=RP1A.200720.011
DEVICE_BUILD_TAGS=release-keys
DEVICE_BUILD_TYPE=user

DEVICE_LCD_WIDTH=1080
DEVICE_LCD_HEIGHT=2400
DEVICE_LCD_DENSITY=440
