#!/usr/bin/env bash
# open-emu — Android runtime control plane for open-emulator.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../lib/common.sh"
android_env

usage() {
  cat <<EOF
Usage: open-emu <command> [args]

Commands:
  profile              Detect host and write performance profile
  setup                Create/refresh AVD with project config
  start [--cold]       Start Android (warm if already running)
  stop                 Stop the emulator cleanly
  status               Show runtime status
  provision            Tune guest for real use + save snapshot (KVM fast path)
  install <apk>        Install an APK (grants runtime permissions)
  launch <component>   Start an activity (pkg/.Activity)
  shell [args...]      adb shell (interactive if no args)
  push <local> <remote>
  pull <remote> <local>
  screenshot [file]    Capture PNG screenshot
  logcat [args...]     adb logcat
  doctor               Run connectivity / readiness checks
  demo                 Boot (if needed), launch Settings, verify network

Environment:
  ANDROID_HEADLESS=1   Force -no-window (default in CI / no DISPLAY)
  ANDROID_CORES=N      Override guest vCPU count
  ANDROID_MEMORY_MB=N  Override guest RAM
  ANDROID_GPU_MODE=... auto|swiftshader|host|guest
  ANDROID_SNAPSHOT_NAME=booted
EOF
}

cmd_profile() {
  detect_host_profile
  cat "$PROFILE_FILE"
}

cmd_setup() {
  "$ROOT/scripts/setup_avd.sh"
}

start_emulator() {
  local cold="${1:-0}"
  # Set when the cold boot is a *fallback* rather than something the user asked for. A fallback
  # must not destroy the snapshot: it is usually recoverable, and deleting it turns a one-off
  # load failure into a mandatory re-provision.
  local preserve_snapshot="${2:-0}"
  require_sdk
  detect_host_profile
  # shellcheck disable=SC1090
  source "$PROFILE_FILE"

  if emulator_running; then
    log "emulator already running (warm path — no reboot)"
    local d
    d="$(wait_for_adb_device 60)" || die "running emulator has no adb device"
    echo "$d" > "$DEVICE_FILE"
    return 0
  fi

  adb_start

  local headless=0
  if [[ "${ANDROID_HEADLESS:-}" == "1" || -z "${DISPLAY:-}" ]]; then
    headless=1
  fi

  local gpu="$GPU_MODE"
  (( HAS_KVM )) || gpu="swiftshader"

  # Never pass `auto`. The emulator resolves it to a concrete renderer that varies by system image
  # — swiftshader on google_apis, lavapipe on AOSP — and records the *resolved* name in the
  # snapshot's hardware.ini. config.ini would still say something else, and the next warm start
  # dies with "The emulator hardware cannot load snapshot". Resolving it here keeps the two in
  # agreement, which is what makes snapshots reloadable at all.
  [[ "$gpu" == "auto" ]] && gpu="swiftshader"

  local avd_dir="$AVD_HOME/${AVD_NAME}.avd"
  if [[ -f "$avd_dir/config.ini" ]]; then
    # hw.gpu.mode must match the -gpu flag below, or the snapshot written by this boot cannot be
    # loaded by the next one. This line is load-bearing, not cosmetic.
    sed -i \
      -e "s/^hw.cpu.ncore=.*/hw.cpu.ncore=${GUEST_CORES}/" \
      -e "s/^hw.ramSize=.*/hw.ramSize=${GUEST_RAM_MB}/" \
      -e "s/^hw.gpu.mode=.*/hw.gpu.mode=${gpu}/" \
      "$avd_dir/config.ini"
  fi

  if (( cold )) && (( preserve_snapshot == 0 )); then
    rm -rf "${avd_dir}/snapshots/${SNAPSHOT_NAME}"
  fi

  local args=(
    -avd "$AVD_NAME"
    -gpu "$gpu"
    -accel "$ACCEL"
    -no-boot-anim
    -no-metrics
    -netdelay none
    -netspeed full
  )

  if (( headless )); then
    # Audio has no sink in a headless/WSL environment — the emulator logs
    # "Could not init 'pa' audio driver" and initializes it anyway. Skip the whole subsystem.
    args+=(-no-window -no-audio)
  fi

  # Device identity (-prop ro.product.*). Baked into the boot, so a snapshot taken afterwards
  # carries them; switching device needs a re-provision.
  local -a device_args=()
  mapfile -t device_args < <(device_prop_args)
  if (( ${#device_args[@]} )) && [[ -n "${device_args[0]}" ]]; then
    args+=("${device_args[@]}")
    log "device profile: ${DEVICE_NAME:-generic}"
  fi

  # Needed only while customizing /system (see scripts/customize_system.sh). Off by default:
  # a writable system means the emulator keeps a qcow2 overlay for it, which is extra I/O on a
  # path where every millisecond shows up in start time.
  if [[ "${ANDROID_WRITABLE_SYSTEM:-}" == "1" ]]; then
    log "system image is WRITABLE this boot (adb remount available)"
    args+=(-writable-system)
  fi

  # KVM: load named snapshot for fast boot.
  # TCG: skip snapshot load (Emulator often rejects/segfaults without KVM).
  if (( cold == 0 )) && snapshot_exists && (( HAS_KVM )); then
    log "fast boot from snapshot '${SNAPSHOT_NAME}' (KVM)"
    args+=(-snapshot "$SNAPSHOT_NAME" -no-snapshot-save)
  else
    if (( HAS_KVM == 0 )) && (( cold == 0 )); then
      log "TCG host: optimized cold boot (keep process alive for warm reuse)"
    else
      log "cold boot"
    fi
    # -no-snapshot-save is as important as -no-snapshot-load here. Without it the emulator writes
    # a 'default_boot' snapshot while quitting (~2s), and cmd_stop SIGKILLs shortly after — landing
    # mid-write and corrupting the snapshot store. The next warm start then fails to load, which
    # used to trigger a retry that deleted the good snapshot. Snapshots are written deliberately by
    # `provision`, never as a side effect of shutting down.
    args+=(-no-snapshot-load -no-snapshot-save)
  fi

  : > "$EMULATOR_LOG"
  log "starting emulator: ${args[*]}"
  # `setsid`, not just `nohup`. nohup only ignores SIGHUP; the process stays in this invocation's
  # session, and WSL tears down a session's processes when the `wsl.exe` that created it exits.
  # From an interactive shell that never happens, so this looked fine for a long time — but the
  # desktop app starts the emulator with a one-shot `wsl.exe` call, and the guest was being killed
  # a second after it finished booting. setsid detaches it into its own session so it outlives the
  # caller. stdin from /dev/null for the same reason: a closed stdin can take the process down.
  setsid nohup "$EMULATOR_BIN" "${args[@]}" </dev/null >>"$EMULATOR_LOG" 2>&1 &
  local pid=$!
  echo "$pid" > "$PID_FILE"
  log "emulator pid=${pid}"

  # No fixed sleep here. wait_for_adb_device already polls, so a flat delay was pure latency —
  # 5s on top of a warm start that only takes ~11s in total.
  # A writable-system boot has to materialise a writable overlay for the 3GB super image before
  # the guest gets anywhere, which routinely runs past the normal wait.
  local adb_wait=180
  [[ "${ANDROID_WRITABLE_SYSTEM:-}" == "1" ]] && adb_wait=600

  local device
  device="$(wait_for_adb_device "$adb_wait")" || {
    tail -n 100 "$EMULATOR_LOG" || true
    die "adb device did not appear"
  }
  log "adb device=${device}"

  if (( cold == 0 )) && (( HAS_KVM )) && snapshot_exists; then
    if grep -q "Failed to load snapshot\|cannot load snapshot" "$EMULATOR_LOG"; then
      log "snapshot load failed — cold booting (snapshot kept for next attempt)"
      kill "$pid" 2>/dev/null || true
      sleep 2
      kill -9 "$pid" 2>/dev/null || true
      rm -f "$PID_FILE"
      pkill -f "qemu-system-x86_64.*${AVD_NAME}" 2>/dev/null || true
      sleep 2
      start_emulator 1 1
      return $?
    fi
  fi

  local boot_timeout=1800
  (( HAS_KVM )) && boot_timeout=300

  wait_for_boot "$device" "$boot_timeout" || {
    tail -n 100 "$EMULATOR_LOG" || true
    die "Android boot_completed not reached"
  }
  log "Android boot_completed=1"
}

cmd_start() {
  local cold=0
  [[ "${1:-}" == "--cold" ]] && cold=1
  local t0=$SECONDS
  start_emulator "$cold"
  log "start finished in $((SECONDS - t0))s"
  cmd_status
}

cmd_stop() {
  local device=""
  device="$(adb_device || true)"
  if [[ -n "$device" ]]; then
    log "requesting emulator kill via adb"
    "$ADB_BIN" -s "$device" emu kill >/dev/null 2>&1 || true
  fi
  if [[ -f "$PID_FILE" ]]; then
    local pid
    pid="$(cat "$PID_FILE")"
    # Give the emulator real time to exit on its own. A hard kill here can interrupt snapshot or
    # qcow2 writes still in flight, which corrupts the AVD's snapshot store — that is exactly how
    # the warm-boot path used to destroy itself. SIGKILL stays as a last resort.
    local waited=0
    while (( waited < 30 )) && kill -0 "$pid" 2>/dev/null; do
      sleep 1
      waited=$((waited + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
      log "emulator still alive after ${waited}s — terminating"
      kill "$pid" 2>/dev/null || true
      sleep 3
      kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
  fi
  pkill -f "qemu-system-x86_64.*${AVD_NAME}" 2>/dev/null || true
  rm -f "$DEVICE_FILE"
  log "emulator stopped"
}

cmd_status() {
  echo "avd=${AVD_NAME}"
  if emulator_running; then
    echo "emulator=running"
    [[ -f "$PID_FILE" ]] && echo "pid=$(cat "$PID_FILE")"
  else
    echo "emulator=stopped"
  fi
  local d
  d="$(adb_device || true)"
  echo "adb_device=${d:-none}"
  if [[ -n "$d" ]]; then
    local boot ver sdk
    boot="$("$ADB_BIN" -s "$d" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')"
    ver="$("$ADB_BIN" -s "$d" shell getprop ro.build.version.release 2>/dev/null | tr -d '\r')"
    sdk="$("$ADB_BIN" -s "$d" shell getprop ro.build.version.sdk 2>/dev/null | tr -d '\r')"
    echo "boot_completed=${boot:-unknown}"
    echo "android=${ver:-unknown} api=${sdk:-unknown}"
  fi
  if snapshot_exists; then
    echo "snapshot=${SNAPSHOT_NAME} present=yes"
  else
    echo "snapshot=${SNAPSHOT_NAME} present=no"
  fi
  [[ -f "$AVD_STATE_DIR/provisioned_at" ]] && echo "provisioned_at=$(cat "$AVD_STATE_DIR/provisioned_at")"
  [[ -f "$PROFILE_FILE" ]] && echo "profile=$(tr '\n' ' ' < "$PROFILE_FILE")"
}

cmd_provision() {
  require_sdk
  if ! emulator_running; then
    start_emulator 1
  fi
  "$ROOT/scripts/provision.sh"
}

cmd_install() {
  local apk="${1:-}"
  [[ -n "$apk" && -f "$apk" ]] || die "usage: open-emu install <apk>"
  require_sdk
  emulator_running || start_emulator 0
  local device
  device="$(adb_device)"
  log "installing $apk"
  local out rc
  set +e
  out="$(timeout 300s "$ADB_BIN" -s "$device" install -r -g -d "$apk" 2>&1)"
  rc=$?
  set -e
  echo "$out" | tee -a "$RUNTIME_LOG"
  if grep -qi 'Success' <<<"$out"; then
    log "install OK"
    return 0
  fi
  # Heuristic: under TCG adb may time out after the package is already installed.
  local pkg_guess
  pkg_guess="$(basename "$apk" .apk | tr '[:upper:]' '[:lower:]')"
  if timeout 30s "$ADB_BIN" -s "$device" shell pm list packages 2>/dev/null | grep -qi "$pkg_guess"; then
    log "install timed out (rc=${rc}) but package appears present"
    return 0
  fi
  if [[ "$apk" == *F-Droid* ]] && timeout 30s "$ADB_BIN" -s "$device" shell pm path org.fdroid.fdroid >/dev/null 2>&1; then
    log "install timed out (rc=${rc}) but F-Droid is present"
    return 0
  fi
  die "install failed (rc=${rc})"
}

cmd_launch() {
  local comp="${1:-}"
  [[ -n "$comp" ]] || die "usage: open-emu launch pkg/.Activity"
  require_sdk
  emulator_running || start_emulator 0
  local device
  device="$(adb_device)"
  "$ADB_BIN" -s "$device" shell input keyevent KEYCODE_WAKEUP || true
  "$ADB_BIN" -s "$device" shell am start -n "$comp"
  sleep 2
  "$ADB_BIN" -s "$device" shell dumpsys activity activities | awk '/mResumedActivity/{print; exit}'
}

cmd_shell() {
  require_sdk
  emulator_running || die "emulator not running"
  local device
  device="$(adb_device)"
  if (($#)); then
    "$ADB_BIN" -s "$device" shell "$@"
  else
    "$ADB_BIN" -s "$device" shell
  fi
}

cmd_push() {
  (($# == 2)) || die "usage: open-emu push <local> <remote>"
  adb_sh push "$1" "$2"
}

cmd_pull() {
  (($# == 2)) || die "usage: open-emu pull <remote> <local>"
  adb_sh pull "$1" "$2"
}

cmd_screenshot() {
  local out="${1:-$LOG_DIR/screen.png}"
  require_sdk
  local device
  device="$(adb_device)"
  "$ADB_BIN" -s "$device" exec-out screencap -p > "$out"
  log "screenshot written to $out"
  echo "$out"
}

cmd_logcat() {
  adb_sh logcat "$@"
}

cmd_doctor() {
  require_sdk
  cmd_status
  local device
  device="$(adb_device || true)"
  [[ -n "$device" ]] || die "start Android before doctor"
  echo "== network =="
  if wait_for_network "$device" 30; then
    echo "network=ok"
  else
    echo "network=fail"
  fi
  echo "== storage =="
  "$ADB_BIN" -s "$device" shell df -h /data | tail -n +1
  echo "== package manager =="
  "$ADB_BIN" -s "$device" shell pm path android
  echo "== free mem =="
  "$ADB_BIN" -s "$device" shell cat /proc/meminfo | awk '/MemTotal|MemFree|MemAvailable/{print}'
}

cmd_demo() {
  require_sdk
  local t0=$SECONDS
  if ! emulator_running; then
    start_emulator 0
    if [[ ! -f "$AVD_STATE_DIR/provisioned_at" ]]; then
      "$ROOT/scripts/provision.sh"
    fi
  fi
  local device
  device="$(adb_device)"
  wait_for_network "$device" 60 || log "WARNING: network not ready"
  cmd_launch "com.android.settings/.Settings"
  local resumed ver sdk
  resumed="$("$ADB_BIN" -s "$device" shell dumpsys activity activities | awk '/mResumedActivity/{print; exit}' | tr -d '\r')"
  ver="$("$ADB_BIN" -s "$device" shell getprop ro.build.version.release | tr -d '\r')"
  sdk="$("$ADB_BIN" -s "$device" shell getprop ro.build.version.sdk | tr -d '\r')"
  mkdir -p "$LOG_DIR"
  cat > "$LOG_DIR/last_success.txt" <<EOF
ok=1
android_version=${ver}
android_api=${sdk}
app=com.android.settings/.Settings
resumed=${resumed}
device=${device}
elapsed_s=$((SECONDS - t0))
time=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF
  cp "$LOG_DIR/last_success.txt" "$ROOT/imported/last_verified.txt"
  log "demo OK in $((SECONDS - t0))s"
  cat "$LOG_DIR/last_success.txt"
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    profile) cmd_profile "$@" ;;
    setup) cmd_setup "$@" ;;
    start) cmd_start "$@" ;;
    stop) cmd_stop "$@" ;;
    status) cmd_status "$@" ;;
    provision) cmd_provision "$@" ;;
    install) cmd_install "$@" ;;
    launch) cmd_launch "$@" ;;
    shell) cmd_shell "$@" ;;
    push) cmd_push "$@" ;;
    pull) cmd_pull "$@" ;;
    screenshot) cmd_screenshot "$@" ;;
    logcat) cmd_logcat "$@" ;;
    doctor) cmd_doctor "$@" ;;
    demo) cmd_demo "$@" ;;
    -h|--help|help|"") usage ;;
    *) die "unknown command: $cmd" ;;
  esac
}

main "$@"
