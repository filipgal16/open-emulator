# Copy to .env and fill in before deploying anywhere reachable from the
# internet. This file itself is committed as documentation, not secrets.

# HMAC secret for click-redirect tokens and postback signatures. Required —
# index.mjs runs with an insecure hardcoded default (and prints a warning)
# if this is unset, which is fine for local testing, never for production.
CLICK_SIGNING_SECRET=

# Port the server listens on.
PORT=8787

# Where to read the Ed25519 *public* key from for POST /v1/license/verify.
# Defaults to monetize/licensing/keys/public.jwk.json (generated by
# monetize/licensing/keygen.mjs). The private key never belongs on this
# server's env at all — issuing happens offline via issue-license.mjs.
LICENSE_PUBLIC_KEY_PATH=
